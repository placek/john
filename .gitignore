# Markdown files are generated exports (make export); the hand-maintained ones
# are whitelisted below. CLAUDE.md and SKILL.md were caught by this rule by
# accident — invisible to review, they drifted out of date (October 2026).
*.md
!README.md
!CLAUDE.md
!SKILL.md
!data/REVIEW_LOG.md
!docs/superpowers/**/*.md

# The SQLite database is generated from data/*.json (make build).
data/egzegeza_jana.sqlite

# Static site is generated by tools/export_site.py (make site).
site/

# Typst export is generated by tools/export_typst.py (make typst).
egzegeza.typ
egzegeza.pdf

# Python bytecode cache.
__pycache__/

# Claude Code session directory.
.claude/

# graft's local graph cache — regenerable, not committed (run `graft build`).
/graft/
