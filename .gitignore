# Markdown files are generated exports (make export); keep only the README
# and the hand-maintained review log.
*.md
!README.md
!data/REVIEW_LOG.md
!docs/superpowers/**/*.md

# The SQLite database is generated from data/*.json (make build).
data/egzegeza_jana.sqlite

# Static site is generated by tools/export_site.py (make site).
site/

# Typst export is generated by tools/export_typst.py (make typst).
egzegeza.typ
egzegeza.pdf

# Python bytecode cache.
__pycache__/

# Claude Code session directory.
.claude/

# graft's local graph cache — regenerable, not committed (run `graft build`).
/graft/
